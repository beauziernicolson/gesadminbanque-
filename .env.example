# Supply the existing GES Supabase Project URL and publishable key.
# Never place a service_role or secret key in this file or any NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional local UI-only preview. It contains no fixture records and performs no writes.
NEXT_PUBLIC_GES_PREVIEW_MODE=false
